# Postgres. On Vercel, the Neon integration sets both of these automatically.
# Pooled connection used by the app:
DATABASE_URL=postgresql://user:password@localhost:5432/goatride
# Direct connection used by `prisma migrate` (optional locally; falls back to DATABASE_URL):
# DATABASE_URL_UNPOOLED=

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Maps
# Browser key for Places autocomplete — restrict to your domains (HTTP referrers) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key for geocoding — restrict to the Geocoding API. Falls back to the public key if unset.
GOOGLE_MAPS_SERVER_KEY=

# Vercel Blob (avatars). Set automatically on Vercel when a Blob store is connected; for local
# uploads, copy it from the store's settings or run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/expire-rides; Vercel Cron sends it automatically. openssl rand -base64 32
CRON_SECRET=

# Emails
EMAIL_FROM=
RESEND_API_KEY=
